DOCKER_HUB_USERNAME=your-dockerhub-id

BACKEND_IMAGE_TAG=latest
WORKER_IMAGE_TAG=latest

WORKER_PORT=8000

BACKEND_PUBLIC_HOST=api.soupspoon.kr

POSTGRES_DB=soupdb
POSTGRES_USER=soup
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_URL=jdbc:postgresql://postgres:5432/soupdb
POSTGRES_USERNAME=soup

MONGO_INITDB_ROOT_USERNAME=soup_mongo
MONGO_INITDB_ROOT_PASSWORD=change_me_mongo_password
MONGO_URI=mongodb://soup_mongo:change_me_mongo_password@mongodb:27017/soupdb?authSource=admin
MONGODB_URI=mongodb://soup_mongo:change_me_mongo_password@mongodb:27017
MONGODB_DB=soupdb

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change_me_redis_password
REDIS_STREAM_KEY=news:processing
REDIS_STREAM_GROUP=soup-worker
REDIS_STREAM_CONSUMER_NAME=

WORKER_POLL_INTERVAL=2
MAX_WORKERS=5

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.soupspoon.kr/login/oauth2/code/google
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://api.soupspoon.kr/login/oauth2/code/kakao

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

JWT_ISSUER=soup
JWT_SECRET=change_me_jwt_secret
JWT_ACCESS_TOKEN_TTL=604800
JWT_REFRESH_TOKEN_TTL=1209600

FRONT_DOMAIN=https://soupspoon.kr
API_DOMAIN=https://api.soupspoon.kr/api/v1

PERPLEXITY_BASE_URL=https://api.perplexity.ai
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
PERPLEXITY_COMPLETIONS_PATH=/chat/completions

OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=text-embedding-3-small
OPENAI_EMBEDDINGS_PATH=/v1/embeddings
